diff --git a/.github/workflows/fast-track-f7-browser.yml b/.github/workflows/fast-track-f7-browser.yml
new file mode 100644
index 0000000..7e90984
--- /dev/null
+++ b/.github/workflows/fast-track-f7-browser.yml
@@ -0,0 +1,201 @@
+name: Fast Track F7 Chromium
+
+on:
+  push:
+    branches: [feature/fast-track-f7-patient-intake]
+
+permissions:
+  contents: read
+
+concurrency:
+  group: fast-track-f7-${{ github.ref }}
+  cancel-in-progress: true
+
+env:
+  F6_SHA: 67001b50bfc28410b7bb4e290c46b876fda2f96f
+  F6_TREE: bc26b4164c7322881e6943d3c0a82c0714c39273
+
+jobs:
+  f7-chromium:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    steps:
+      - name: Checkout exact F7 candidate
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Check Git tree and protect existing medical contracts
+        shell: bash
+        run: |
+          set -euo pipefail
+          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
+          test "$(git rev-parse "$F6_SHA^{tree}")" = "$F6_TREE"
+          git merge-base --is-ancestor "$F6_SHA" HEAD
+          test -z "$(git rev-list --merges "$F6_SHA..HEAD")"
+          git diff --exit-code "$F6_SHA" HEAD -- backend/app backend/migrations backend/requirements-dev.txt tools/tests/wp_h/package-lock.json .github/workflows/ci.yml .github/workflows/fast-track-f2-browser.yml .github/workflows/fast-track-f3-browser.yml .github/workflows/fast-track-f4-browser.yml .github/workflows/fast-track-f5-browser.yml .github/workflows/fast-track-f6-browser.yml
+          while IFS= read -r path; do
+            case "$path" in
+              .github/workflows/fast-track-f7-browser.yml|backend/tests/test_frontend_csp.py|backend/tests/test_wp24a_patient_create.py|backend/tests/test_wp24b_idempotency.py|backend/tests/test_wp24c_duplicates.py|index.html|static/app.js|static/styles.css|tools/tests/fast_track_f7/journey.cjs|tools/tests/fast_track_f7/run.py|tools/tests/wp_i_create/create.cjs) ;;
+              *) printf 'Unexpected changed path: %s\n' "$path"; exit 1 ;;
+            esac
+          done < <(git diff --name-only "$F6_SHA" HEAD)
+          test -z "$(git status --porcelain)"
+          echo "F7_CANDIDATE=$GITHUB_SHA"
+          echo "F7_TREE=$(git rev-parse "$GITHUB_SHA^{tree}")"
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
+        with:
+          python-version: '3.13.18'
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
+        with:
+          node-version: '22.23.5'
+      - name: Install pinned synthetic test dependencies
+        run: |
+          python -m pip install --disable-pip-version-check -r backend/requirements-dev.txt
+          npm ci --ignore-scripts --prefix tools/tests/wp_h
+          tools/tests/wp_h/node_modules/.bin/playwright install --with-deps chromium
+      - name: Run F7 and affected browser regressions
+        shell: bash
+        run: |
+          set -euo pipefail
+          umask 077
+          export AXE_SOURCE="$PWD/tools/tests/wp_h/node_modules/axe-core/axe.min.js"
+          export PLAYWRIGHT_MODULE="$PWD/tools/tests/wp_h/node_modules/playwright"
+          export BROWSER_EXECUTABLE
+          BROWSER_EXECUTABLE="$(node -p 'require(process.env.PLAYWRIGHT_MODULE).chromium.executablePath()')"
+          export WP_H_FULL_CHROMIUM="$BROWSER_EXECUTABLE"
+          test "$(node -p 'require(process.env.PLAYWRIGHT_MODULE+"/package.json").version')" = 1.62.1
+          test "$(node -p 'require(require("node:path").dirname(process.env.AXE_SOURCE)+"/package.json").version')" = 4.11.0
+          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
+          test -z "$(git status --porcelain)"
+          mkdir -m 700 "$RUNNER_TEMP/f7-public"
+          receipt="$RUNNER_TEMP/f7-journey"
+          if ! python -B tools/tests/fast_track_f7/run.py --out "$receipt"; then
+            if test -f "$receipt/browser.local.log"; then
+              grep -Eo 'fast_track_f7/[a-z_-]+\.(cjs|py):[0-9]+(:[0-9]+)?' "$receipt/browser.local.log" | head -12 || true
+            fi
+            exit 1
+          fi
+          python - "$receipt/public.json" "$(git rev-parse 'HEAD^{tree}')" <<'PYTHON'
+          import json
+          import os
+          import sys
+
+          with open(sys.argv[1]) as file:
+              receipt = json.load(file)
+          assert receipt["candidateSha"] == os.environ["GITHUB_SHA"]
+          assert receipt["candidateTree"] == sys.argv[2]
+          assert not receipt["dirtyCheckout"] and receipt["syntheticOnly"]
+          PYTHON
+          cp "$receipt/public.json" "$RUNNER_TEMP/f7-public/f7-journey.json"
+          for suite in create errors workflows zoom; do
+            receipt="$RUNNER_TEMP/f7-i4-$suite"
+            if ! python -B tools/tests/wp_i_create/run.py --suite "$suite" --out "$receipt"; then
+              if test -f "$receipt/card.log"; then
+                grep -Eo 'wp_i_create/[a-z_-]+\.(cjs|py):[0-9]+(:[0-9]+)?' "$receipt/card.log" | head -12 || true
+              fi
+              exit 1
+            fi
+            python - "$suite" "$RUNNER_TEMP/f7-public/i4-$suite.json" <<'PYTHON'
+          import json
+          import os
+          import sys
+          from pathlib import Path
+
+          Path(sys.argv[2]).write_text(json.dumps({
+              "suite": sys.argv[1], "result": "PASS", "candidateSha": os.environ["GITHUB_SHA"],
+          }) + "\n")
+          PYTHON
+          done
+          for suite in journey schedule workflows loading decisions records zoom decisionzoom recordszoom; do
+            receipt="$RUNNER_TEMP/f6-$suite"
+            printf 'F6_BROWSER_SUITE=%s\n' "$suite"
+            if ! python -B tools/tests/fast_track_f6/run.py --suite "$suite" --out "$receipt"; then
+              for log in "$receipt/browser.local.log" "$receipt/card.log"; do
+                if test -f "$log"; then
+                  grep -Eo '(fast_track_f6|wp_i_consilium)/[a-z_-]+\.(cjs|py):[0-9]+(:[0-9]+)?' "$log" | head -12 || true
+                fi
+              done
+              exit 1
+            fi
+            python - "$receipt/public.json" "$(git rev-parse 'HEAD^{tree}')" <<'PYTHON'
+          import json
+          import os
+          import sys
+
+          with open(sys.argv[1]) as file:
+              receipt = json.load(file)
+          assert receipt["candidateSha"] == os.environ["GITHUB_SHA"]
+          assert receipt["candidateTree"] == sys.argv[2]
+          assert not receipt["dirtyCheckout"] and receipt["syntheticOnly"]
+          PYTHON
+            cp "$receipt/public.json" "$RUNNER_TEMP/f7-public/f6-$suite.json"
+          done
+          for suite in fast_track_f5 fast_track_f4 fast_track_f3 fast_track_f2 fast_track_f1; do
+            receipt="$RUNNER_TEMP/$suite"
+            printf 'F6_REGRESSION_SUITE=%s\n' "$suite"
+            if ! python -B "tools/tests/$suite/run.py" --out "$receipt"; then
+              # Report source frames only: fixture IDs, session values and response bodies stay private.
+              if test -f "$receipt/browser.local.log"; then
+                grep -Eo 'fast_track_f[12345]/[a-z_-]+\.(cjs|py):[0-9]+:[0-9]+' "$receipt/browser.local.log" | head -12 || true
+              fi
+              exit 1
+            fi
+            python - "$receipt/public.json" "$suite" "$(git rev-parse 'HEAD^{tree}')" <<'PYTHON'
+          import json
+          import os
+          import sys
+
+          with open(sys.argv[1]) as file:
+              receipt = json.load(file)
+          assert receipt["candidateSha"] == os.environ["GITHUB_SHA"]
+          assert not receipt["dirtyCheckout"] and receipt["syntheticOnly"]
+          if sys.argv[2] in {"fast_track_f2", "fast_track_f3", "fast_track_f4", "fast_track_f5"}:
+              assert receipt["candidateTree"] == sys.argv[3]
+          PYTHON
+            cp "$receipt/public.json" "$RUNNER_TEMP/f7-public/$suite.json"
+          done
+          for scenario in navigation unknownDenial; do
+            out="$RUNNER_TEMP/history-$scenario"
+            if ! HISTORY_SCENARIO="$scenario" python -B tools/tests/wp_i_card/run.py --suite history --out "$out"; then
+              if test -f "$out/card.log"; then
+                grep -Eo 'history\.cjs:[0-9]+:[0-9]+' "$out/card.log" | head -12 || true
+              fi
+              exit 1
+            fi
+            python - "$out/history-results.json" "$scenario" "$RUNNER_TEMP/f7-public/history-$scenario.json" <<'PYTHON'
+          import json
+          from pathlib import Path
+          import sys
+
+          result = json.loads(Path(sys.argv[1]).read_bytes())
+          expected = {"navigation": 6, "unknownDenial": 1}[sys.argv[2]]
+          assert result["syntheticOnly"] is True and result["realBackend"] is True
+          assert result["phase"] == "complete" and len(result["check"]) == expected
+          Path(sys.argv[3]).write_text(json.dumps({"scenario": sys.argv[2], "groups": expected, "result": "PASS"}) + "\n")
+          PYTHON
+          done
+          out="$RUNNER_TEMP/inbox-fix1"
+          if ! python -B tools/tests/wp_i_notifications/run.py --suite fix1 --count 1000 --out "$out"; then
+            if test -f "$out/card.log"; then grep -Eo 'fix1\.cjs:[0-9]+:[0-9]+' "$out/card.log" | head -12 || true; fi
+            exit 1
+          fi
+          python - "$out/results.json" "$RUNNER_TEMP/f7-public/notifications-fix1.json" <<'PYTHON'
+          import json
+          import sys
+          from pathlib import Path
+
+          result = json.loads(Path(sys.argv[1]).read_bytes())
+          assert result["realBackend"] and len(result["checks"]) == 12
+          Path(sys.argv[2]).write_text(json.dumps({"groups": 12, "result": "PASS"}) + "\n")
+          PYTHON
+          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
+          git diff --exit-code
+      - name: Retain sanitized machine receipts
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: fast-track-f7-browser-${{ github.sha }}
+          path: ${{ runner.temp }}/f7-public/*.json
+          if-no-files-found: error
+          retention-days: 14
